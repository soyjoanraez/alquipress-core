# ============================================================
# ALQUIPRESS CORE — .gitignore
# ============================================================
# Este repositorio SOLO contiene el plugin alquipress-core.
# Se ignora todo por defecto y se permite solo lo necesario.
# ============================================================

# Ignorar TODO por defecto
*

# ------------------------------------------------------------
# Permitir solo los archivos del plugin alquipress-core
# ------------------------------------------------------------
!.gitignore
!.gitattributes
!.cpanel.yml
!README.md
!DEVELOPERS.md
!DOCUMENTATION.md
!TESTING.md
!TESTING-PLAN.md
!TESTING-URGENT-FIXES.md
!SECURITY-AUDIT.md
!SECURITY-FIXES.md
!PRODUCTION-CHECKLIST.md
!CODE-REVIEW-FINAL.md
!DESIGN-SYSTEM.md
!alquipress-core.php

# Permitir carpetas del plugin (hay que permitir la carpeta y su contenido)
!includes/
!includes/**
!docs/
!docs/**
!conf/
!conf/**

# Permitir el hook pre-commit
!.githooks/
!.githooks/**
